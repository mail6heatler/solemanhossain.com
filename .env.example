# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Settings -> Environment Variables.

# Your admin password. It always works as a recovery key, even after you set a
# different password inside the dashboard. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Random secret used to sign your login cookie (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Postgres connection string. Leave empty locally to use the built-in database in ./.data
# On Vercel, this is filled in automatically when you add a Neon database.
DATABASE_URL=
